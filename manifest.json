{
  "manifest_version": 3,
  "name": "ChatGPT Game Autoplay",
  "version": "1.0.0",
  "description": "Plays the mini-game shown while ChatGPT generates images for you, automatically. Everything runs locally in the browser; nothing is sent anywhere.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChatGPT Game Autoplay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "algorithms.js",
        "vision.js",
        "logger.js",
        "page.js",
        "reader.js",
        "i18n.js",
        "panel.js",
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
